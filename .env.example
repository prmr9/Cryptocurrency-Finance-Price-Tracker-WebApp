# Copy to .env.local and fill in. No secrets belong in git.
#
# CoinGecko is the price source. The public API needs no key and is rate
# limited; a demo key raises the ceiling. Leave blank to use the public tier.
REACT_APP_COINGECKO_API_KEY=

# Override only to point at a mock or a proxy during testing.
REACT_APP_COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
